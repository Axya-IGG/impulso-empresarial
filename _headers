/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

# Paginas do dia do evento: protegidas por token na URL, nao por sessao.
# Fora do indice de busca e sem cache — o telao precisa sempre do HTML novo,
# e o endereco nao deve sobreviver no cache de um aparelho emprestado.
/formulario
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/formulario.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/porta
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/porta.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/sorteio
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/sorteio.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Painel interno: fora dos buscadores mesmo que alguem publique o link, e
# sem cache para nao deixar dados de lead parados no navegador.
/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# A API nunca pode ser cacheada na borda: /api/admin/leads devolveria a
# resposta de uma sessao para a requisicao de outra.
/api/*
  Cache-Control: no-store

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# Imagens e vídeo: cache de 7 dias. Não usa "immutable" porque estes
# arquivos não têm hash no nome e podem ser substituídos no lugar.
/assets/*
  Cache-Control: public, max-age=604800

/images/*
  Cache-Control: public, max-age=604800
